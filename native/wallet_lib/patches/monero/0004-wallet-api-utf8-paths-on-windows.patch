--- a/src/wallet/api/wallet_manager.cpp
+++ b/src/wallet/api/wallet_manager.cpp
@@ -39,6 +39,10 @@
 #include "net/http_client.h"
 #include <boost/filesystem.hpp>
 #include <boost/regex.hpp>
+#ifdef WIN32
+#include <boost/locale.hpp>
+#include <locale>
+#endif
 
 #undef MONERO_DEFAULT_LOG_CATEGORY
 #define MONERO_DEFAULT_LOG_CATEGORY "WalletAPI"
@@ -421,6 +425,15 @@ WalletManager *WalletManagerFactory::getWalletManager()
     static WalletManagerImpl * g_walletManager = nullptr;
 
     if  (!g_walletManager) {
+#ifdef WIN32
+        // Paths arrive as UTF-8. Without this, Boost.Filesystem reads them in
+        // the system's legacy code page, and a wallet in a folder whose name
+        // is not ASCII is neither found nor recognised as existing. This is
+        // what Wallet::init() does for programs that call it; it is done here
+        // so that it does not depend on also configuring logging.
+        std::locale::global(boost::locale::generator().generate(""));
+        boost::filesystem::path::imbue(std::locale());
+#endif
         g_walletManager = new WalletManagerImpl();
     }
 
